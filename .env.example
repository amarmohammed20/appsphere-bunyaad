# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `supabase status` after `supabase start`.

# Public — inlined into the browser bundle. Only ever put public values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry. Blank means error reporting is disabled, not broken.
# Not a secret — it ships in the browser bundle. See docs/sentry-setup.md.
NEXT_PUBLIC_SENTRY_DSN=
