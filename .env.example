# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `supabase status` after `supabase start`.

# Public — inlined into the browser bundle. Only ever put public values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix with NEXT_PUBLIC_.
# Bypasses row-level security. Only set it if something genuinely needs it.
SUPABASE_SERVICE_ROLE_KEY=
