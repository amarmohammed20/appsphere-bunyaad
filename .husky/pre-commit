#!/bin/sh

[ -n "$CI" ] && exit 0

if [ ! -x ./node_modules/.bin/lint-staged ]; then
  echo "lint-staged is not installed in this worktree."
  echo "Run 'pnpm install' before committing."
  exit 1
fi

echo "Running pre-commit checks..."

echo "Linting and formatting staged files..."
pnpm exec lint-staged --quiet || {
  echo ""
  echo "Lint failed. Fix the errors above, then stage and commit again."
  echo "  pnpm lint:fix    auto-fix what can be fixed"
  exit 1
}

echo "All pre-commit checks passed"
exit 0
