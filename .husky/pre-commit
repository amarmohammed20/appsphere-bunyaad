# Fast checks on staged files only. Whole-repo work belongs in CI.

# CI runs the full suite already.
[ -n "$CI" ] && exit 0

if [ ! -x ./node_modules/.bin/lint-staged ]; then
  echo "pre-commit: lint-staged is not installed." >&2
  echo "  Run 'pnpm install' before committing." >&2
  exit 1
fi

# `pnpm exec` pins resolution to this repo's node_modules.
# `--quiet` hides progress chatter; failures still print in full.
pnpm exec lint-staged --quiet
